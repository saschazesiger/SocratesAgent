{
  "name": "socrates-tool-browserstack",
  "version": "0.0.0",
  "private": true,
  "description": "The BrowserStack device driver (qa) of Socrates' own test catalog; see TOOL.md",
  "type": "module",
  "bin": {
    "qa": "./bin/qa"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
