    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  }
}
